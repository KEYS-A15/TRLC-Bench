; TRLCBench Hospital p02 Valid Plan
; Two batches: b1→OR1, b2→OR2. Shared autoclave ac1.
; Both run in parallel through early pipeline (decontam, wash).
; Diverge at sterilize: b1 gets autoclave first [8,13], b2 waits [13,18].
; b1 delivers to OR1 (window [0,28], slack 7.0)
; b2 delivers to OR2 (window [10,38], slack 11.0)
; Overall makespan: 27.0
;
; Concurrency is NECESSARY: sequential processing would miss OR1 window.
; Autoclave contention is the structural bottleneck.

; --- b1 pipeline ---
0.000: (transfer b1 intake decontam_st) [1.000]
1.000: (decontaminate b1 decontam_st) [3.000]
4.000: (transfer b1 decontam_st wash_st) [1.000]
5.000: (wash b1 wash_st) [2.000]
7.000: (transfer b1 wash_st sterilize_st) [1.000]
8.000: (sterilize b1 sterilize_st ac1) [5.000]
13.000: (transfer b1 sterilize_st cool_st) [1.000]
14.000: (cool b1 cool_st) [3.000]
17.000: (transfer b1 cool_st pack_st) [1.000]
18.000: (pack b1 pack_st) [1.000]
19.000: (deliver b1 pack_st or1 or1_st) [2.000]

; --- b2 pipeline (parallel, waits only for autoclave) ---
0.000: (transfer b2 intake decontam_st) [1.000]
1.000: (decontaminate b2 decontam_st) [3.000]
4.000: (transfer b2 decontam_st wash_st) [1.000]
5.000: (wash b2 wash_st) [2.000]
7.000: (transfer b2 wash_st sterilize_st) [1.000]
13.000: (sterilize b2 sterilize_st ac1) [5.000]
18.000: (transfer b2 sterilize_st cool_st) [1.000]
19.000: (cool b2 cool_st) [3.000]
22.000: (transfer b2 cool_st pack_st) [1.000]
23.000: (pack b2 pack_st) [1.000]
24.000: (deliver b2 pack_st or2 or2_st) [3.000]
